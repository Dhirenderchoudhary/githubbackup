{
  "name": "gitbackup-repo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Back up the GitHub repositories you created to one destination you choose.",
  "license": "MIT",
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "build:cli": "npm run build --workspace gitbackup",
    "backup": "gitbackup backup",
    "test": "npm test --workspace gitbackup && node --test test/*.test.ts",
    "typecheck": "npm run typecheck --workspace gitbackup"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
