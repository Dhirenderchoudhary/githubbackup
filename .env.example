# Copy this file to .env in the repository root. Fill in one destination.
# GITBACKUP_TO is s3, r2, or drive.

GITHUB_TOKEN=
GITBACKUP_TO=s3

# Amazon S3
S3_BUCKET=
AWS_REGION=us-east-1
S3_PREFIX=gitbackup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.example

# Cloudflare R2. Set GITBACKUP_TO=r2 to use these.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_PREFIX=gitbackup
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Google Drive. Set GITBACKUP_TO=drive to use these.
# Create an OAuth client with redirect URI http://127.0.0.1:53682/callback
# Then run: npx gitbackup auth drive
# Paste the printed token into GOOGLE_REFRESH_TOKEN.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# DRIVE_FOLDER_ID=root
