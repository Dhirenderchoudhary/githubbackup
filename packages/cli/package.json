{
  "name": "gitbackup",
  "version": "1.0.0",
  "description": "Back up the GitHub repositories you created, with every branch, tag, and note, to Amazon S3, Cloudflare R2, or Google Drive.",
  "keywords": [
    "github",
    "backup",
    "git",
    "s3",
    "cloudflare-r2",
    "google-drive",
    "cli",
    "restore"
  ],
  "homepage": "https://githubbackup.dhirenderchoudhary.com",
  "bugs": {
    "url": "https://github.com/Dhirenderchoudhary/githubbackup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhirenderchoudhary/githubbackup.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Dhirender Choudhary",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "gitbackup": "./bin/gitbackup.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "backup": "node bin/gitbackup.js backup",
    "start": "node bin/gitbackup.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/lib-storage": "^3.1035.0",
    "tar": "^7.5.13",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.9.3"
  }
}
