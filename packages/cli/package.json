{
  "name": "gitbackup",
  "version": "1.0.0",
  "description": "Back up the GitHub repositories you created to one destination you choose.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "gitbackup": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "backup": "node src/cli.ts backup",
    "start": "node src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/lib-storage": "^3.1035.0",
    "tar": "^7.5.13",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.9.3"
  }
}
